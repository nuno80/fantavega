 export const canUserBidOnPlayer = async (
@@
 };
+
+export interface PlayerCooldownSummary {
+ playerId: number;
+ expiresAt: number;
+ timeRemaining: number;
+ message: string;
+}
+
+/**
+ * Loads every active cooldown for one user in one round trip.
+ * The caller maps the result onto the current page of players, avoiding N+1 queries.
+ */
+export const getUserActiveCooldowns = async (
+ userId: string,
+ leagueId?: number,
+): Promise<Map<number, PlayerCooldownSummary>> => {
+ const now = Math.floor(Date.now() / 1000);
+ const result = await db.execute({
+ sql: `
+ SELECT player_id, expires_at
+ FROM user_player_preferences
+ WHERE user_id = ?
+ AND preference_type = 'cooldown'
+ AND expires_at > ?
+ ${leagueId === undefined ? "" : "AND league_id = ?"}
+ `,
+ args: leagueId === undefined ? [userId, now] : [userId, now, leagueId],
+ });
+
+ const cooldowns = new Map<number, PlayerCooldownSummary>();
+ for (const row of result.rows) {
+ const playerId = Number(row.player_id);
+ const expiresAt = Number(row.expires_at);
+ cooldowns.set(playerId, {
+ playerId,
+ expiresAt,
+ timeRemaining: Math.max(0, expiresAt - now),
+ message: "Giocatore in cooldown",
+ });
+ }
+ return cooldowns;
+};

