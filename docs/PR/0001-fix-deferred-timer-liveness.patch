From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
Subject: [PATCH 1/3] fix(auction): make deferred timer activation liveness-safe

Apply from repository root:
  git apply --check 0001-fix-deferred-timer-liveness.patch
  git apply 0001-fix-deferred-timer-liveness.patch

diff --git a/src/app/api/user/auction-states/route.ts b/src/app/api/user/auction-states/route.ts
--- a/src/app/api/user/auction-states/route.ts
+++ b/src/app/api/user/auction-states/route.ts
@@
 import { db } from "@/lib/db";
+import { activateTimersForUser } from "@/lib/db/services/response-timer.service";
 import { updateHeartbeat } from "@/lib/db/services/session.service";
@@
- try { await updateHeartbeat(user.id); } catch (error) { console.error("[USER_AUCTION_STATES] Heartbeat update failed:", error); }
+ try {
+ const heartbeatAt = await updateHeartbeat(user.id);
+ // Deferred activation is anchored to a heartbeat that was persisted successfully.
+ await activateTimersForUser(user.id, heartbeatAt);
+ } catch (error) {
+ console.error("[USER_AUCTION_STATES] Session refresh failed:", error);
+ }

diff --git a/src/app/api/leagues/[league-id]/auction-state/route.ts b/src/app/api/leagues/[league-id]/auction-state/route.ts
--- a/src/app/api/leagues/[league-id]/auction-state/route.ts
+++ b/src/app/api/leagues/[league-id]/auction-state/route.ts
@@
 import { AuctionStatusDetails, getAuctionStatusForPlayer } from "@/lib/db/services/bid.service";
+import { activateTimersForUser } from "@/lib/db/services/response-timer.service";
 import { updateHeartbeat } from "@/lib/db/services/session.service";
@@
- try { await updateHeartbeat(user.id); } catch (error) { console.error("[AUCTION-STATE] Heartbeat update failed", error); }
+ try {
+ const heartbeatAt = await updateHeartbeat(user.id);
+ // Read state only after the pending timers have been claimed atomically.
+ await activateTimersForUser(user.id, heartbeatAt);
+ } catch (error) {
+ console.error("[AUCTION-STATE] Session refresh failed", error);
+ }

diff --git a/src/lib/db/services/session.service.ts b/src/lib/db/services/session.service.ts
--- a/src/lib/db/services/session.service.ts
+++ b/src/lib/db/services/session.service.ts
@@
  const retry = await db.execute({ sql: "UPDATE user_sessions SET last_heartbeat = ? WHERE user_id = ? AND session_end IS NULL", args: [now, userId] });
  if (retry.rowsAffected === 0) {
- console.warn(`[SESSION] Heartbeat upsert raced: no active session after retry for ${userId}`);
+ // Never return a timestamp that was not persisted: callers use it to start timers.
+ throw new Error(`Heartbeat upsert failed after retry for ${userId}`);
  }
@@
  return now;
 };

diff --git a/socket-server.ts b/socket-server.ts
--- a/socket-server.ts
+++ b/socket-server.ts
@@
 let recordUserLogout: ((userId: string, notAfter?: number) => Promise) | null = null;
+let updateHeartbeat: ((userId: string) => Promise<number>) | null = null;
@@
  const sessionModule = await import("@/lib/db/services/session.service");
  recordUserLogout = sessionModule.recordUserLogout;
+ updateHeartbeat = sessionModule.updateHeartbeat;
@@
  const userSockets = new Map<string, Set >();
  const disconnectTimers = new Map<string, ReturnType >();
+ const heartbeatTimers = new Map<string, ReturnType >();
@@
  if (userId) {
@@
  userSockets.set(userId, sockets);
+
+ // Socket liveness is independent from HTTP polling. Persist it so a temporary
+ // polling failure, or another Socket.IO instance, cannot create a false logout.
+ if (!heartbeatTimers.has(userId)) {
+ void updateHeartbeat?.(userId).catch((error) =>
+ console.error("[SOCKET] initial heartbeat failed", error),
+ );
+ const heartbeatTimer = setInterval(() => {
+ void updateHeartbeat?.(userId).catch((error) =>
+ console.error("[SOCKET] heartbeat failed", error),
+ );
+ }, 45_000);
+ heartbeatTimers.set(userId, heartbeatTimer);
+ }
@@
  if (sockets.size === 0) userSockets.delete(uid);
  if (sockets.size > 0) return;
+
+ const heartbeatTimer = heartbeatTimers.get(uid);
+ if (heartbeatTimer) clearInterval(heartbeatTimer);
+ heartbeatTimers.delete(uid);
@@
  for (const timer of disconnectTimers.values()) clearTimeout(timer);
  disconnectTimers.clear();
+ for (const timer of heartbeatTimers.values()) clearInterval(timer);
+ heartbeatTimers.clear();
